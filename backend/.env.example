DATABASE_MODE=sqlite
# Set DATABASE_MODE=supabase when a network connection to Supabase is available.
DATABASE_URL=postgresql+psycopg://postgres:replace-with-your-password@your-host:5432/postgres
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Local development returns a reset link in the API response. Production must use email.
PASSWORD_RESET_DELIVERY_MODE=development
# Optional: enables external AI analysis of private source text. Never expose this key to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Maximum new AI jobs (including retries) per project per UTC day.
AI_DAILY_PROJECT_JOB_LIMIT=5
